{
  "expo": {
    "name": "Goodfriends",
    "slug": "goodfriends",
    "version": "1.0.0",
    "scheme": "goodfriends",
    "orientation": "portrait",
    "icon": "./assets/goodfriends_icon_1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.goodfriends.crew",
      "buildNumber": "3",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Goodfriends uses your camera to add photos to plan moments.",
        "NSPhotoLibraryUsageDescription": "Goodfriends accesses your photos to share moments with your crew."
      }
    },
    "android": {
      "package": "com.goodfriends.crew",
      "adaptiveIcon": {
        "backgroundColor": "#FFFBF5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash_wordmark.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#FFFBF5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f013d069-172f-4703-bc4e-2c05cbf9fd87"
      }
    }
  }
}
